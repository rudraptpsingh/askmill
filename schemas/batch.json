{
  "$defs": {
    "Request": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "askmill.request.v1",
          "default": "askmill.request.v1"
        },
        "prompt": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "images": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Images",
          "type": "array"
        },
        "max_tokens": {
          "default": 2048,
          "maximum": 16384,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "timeout": {
          "default": 180.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout",
          "type": "number"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 128,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "Request",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "reference": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reference",
        "content_sha256"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "askmill.batch.v1",
      "default": "askmill.batch.v1"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/Request"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Requests",
      "type": "array"
    }
  },
  "required": [
    "requests"
  ],
  "title": "Batch",
  "type": "object"
}
